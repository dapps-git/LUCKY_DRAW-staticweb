{
  "name": "luckydraw",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n \"frontend,backend\" -c \"blue,green\" \"vite\" \"npm run server:dev\"",
